# API base URL của backend local (pull từ ticket-system-uni.git)
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Google OAuth Client ID cho Google Identity Services (A26).
# Lấy từ Google Cloud Console; để trống sẽ ẩn nút Google và chỉ dùng dev-paste.
VITE_GOOGLE_CLIENT_ID=

# Bật panel dev-paste token ở màn đăng nhập (true khi test với backend local).
VITE_ENABLE_DEV_LOGIN=true
